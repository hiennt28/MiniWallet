# Sao chép thành file .env (đã gitignore) rồi điền mật khẩu thật.
# Spring tự đọc file này khi chạy từ thư mục miniwallet-backend (xem spring.config.import).
DB_URL=jdbc:postgresql://localhost:5432/miniwallet
DB_USERNAME=miniwallet
DB_PASSWORD=
TEST_DB_URL=jdbc:postgresql://localhost:5432/miniwallet_test

# Khóa ký JWT (Base64, tối thiểu 32 byte). Tạo bằng: openssl rand -base64 48
JWT_SECRET=
